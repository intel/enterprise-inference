set -euo pipefail

MM_VERSION="2.1.0"

# Kill any background jobs (log streamers, delayed cleanup) on exit.
trap 'jobs -p | xargs -r kill 2>/dev/null || true' EXIT

# ── Paths ────────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MM_LIB="$SCRIPT_DIR/lib"
MM_TEMPLATES="${MM_TEMPLATES:-$SCRIPT_DIR/templates}"
# Legacy per-directory runtime configs (fallback only). The primary source is
# the `runtimes:` map inside models.yaml (MM_CONFIG); raw ClusterServingRuntime
# manifests still live here, referenced via `serving_runtime_manifest:`.
MM_RUNTIMES="${MM_RUNTIMES:-$SCRIPT_DIR/runtimes}"
MM_CONFIG="${MM_CONFIG:-$SCRIPT_DIR/models.yaml}"

# ── Libraries ────────────────────────────────────────────────────────────────
source "$MM_LIB/helpers.sh"
source "$MM_LIB/config.sh"
source "$MM_LIB/routing.sh"
source "$MM_LIB/nri.sh"
# cpu_policy.sh dispatches to nri.sh, so it must be sourced after it.
source "$MM_LIB/cpu_policy.sh"

# ── Global option state ──────────────────────────────────────────────────────
DRY_RUN=false
WAIT=false
WAIT_TIMEOUT=900            # deploy default; large because model load + warmup is slow
WAIT_TIMEOUT_SET=false      # true once --wait-timeout is given explicitly
UNDEPLOY_WAIT_TIMEOUT=180   # undeploy default: pod graceful shutdown is quick (3 min ceiling)
DOWNLOAD_TIMEOUT=7200

EXTRA_ARGS=()
EXTRA_ENV=()
# Extra metadata labels for the serving CR. Lets a caller stamp its own
# ownership marker: the built-in managed-by=model-manager is shared by every
# caller, so it cannot distinguish who deployed a model.
EXTRA_LABELS=()

# Per-model / per-version override JSON, set during resolution. Safe defaults
# here so build_env_block / build_args_block never see an unset var (a brace
# default in those hot paths gets mangled by bash parameter expansion).
MODEL_ARGS_JSON="[]"; MODEL_ENV_JSON="{}"
RUNTIME_VERSION_ARGS_JSON="[]"; RUNTIME_VERSION_ENV_JSON="{}"
MODEL_SERVERS_JSON="{}"; MODEL_DEFAULT_SERVER=""; MODEL_RUNTIME_RAW=""; MODEL_SERVER_VERSION_RAW=""
MODEL_SERVER_VERSION=""

OPT_ID=""; OPT_NAME=""; OPT_SERVER=""; OPT_AS=""
OPT_CPU=""; OPT_MEMORY=""; OPT_REPLICAS=""
OPT_TP=""; OPT_SERVER_VERSION=""
# CPU-pinning policy override for this deploy. Empty → MM_CPU_POLICY, then
# cluster auto-detection (see lib/cpu_policy.sh).
OPT_CPU_POLICY=""

# Deprecated but referenced in internal paths — kept as empty defaults so we
# don't have to touch every downstream conditional.
OPT_NODE=""; OPT_CATEGORY=""; OPT_ROUTING=""; OPT_BALLOON_TYPE=""

POSITIONAL=()

require_int() {
    [[ "$2" =~ ^[0-9]+$ ]] || abort "--$1 requires a positive integer, got: $2"
}

# Validate a --label argument up front: a malformed key or value would otherwise
# only surface as a rejected apply, long after the weights download.
require_label() {
    [[ "$1" == *=* ]] || abort "--label requires KEY=VALUE, got: $1"
    local key="${1%%=*}" value="${1#*=}"
    [[ -n "$key" ]] || abort "--label key must not be empty: $1"
    # Optional DNS-subdomain prefix, then a name; value may be empty (k8s allows it).
    [[ "$key" =~ ^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[a-zA-Z0-9]([-_.a-zA-Z0-9]*[a-zA-Z0-9])?$ ]] \
        || abort "--label key is not a valid Kubernetes label key: $key"
    [[ -z "$value" || "$value" =~ ^[a-zA-Z0-9]([-_.a-zA-Z0-9]*[a-zA-Z0-9])?$ ]] \
        || abort "--label value is not a valid Kubernetes label value: $value"
}

