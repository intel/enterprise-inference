# model-manager — deploy LLM inference models on Kubernetes.
# Runs the Python package in core/ with the first Python >= 3.9 that has PyYAML:
# the active virtualenv, a .venv in this or a parent directory, then python3.
set -euo pipefail
MM_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

candidates=("${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python3}")
dir="$MM_DIR"
while [[ "$dir" != "/" ]]; do
    candidates+=("$dir/.venv/bin/python3")
    dir="$(dirname "$dir")"
done
candidates+=(python3)

for py in "${candidates[@]}"; do
    if [[ -n "$py" ]] && "$py" -c 'import sys, yaml; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
        # Under -c, sys.path[0] is the caller's cwd; point it at this directory so core/ resolves here.
        exec "$py" -c 'import sys; sys.path[0] = sys.argv.pop(1); from core.cli import main; main()' "$MM_DIR" "$@"
    fi
done
echo "[ERROR]  model-manager needs Python >= 3.9 with PyYAML: pip install -r $MM_DIR/requirements.txt" >&2
exit 1
