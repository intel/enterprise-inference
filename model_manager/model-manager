# ── Argument parsing (single pass) ───────────────────────────────────────────
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)      DRY_RUN=true;                      shift ;;
            --wait)         WAIT=true;                         shift ;;
            --wait-timeout) require_int wait-timeout "$2"; WAIT_TIMEOUT="$2"; WAIT_TIMEOUT_SET=true; shift 2 ;;
            --id)           OPT_ID="$2";                       shift 2 ;;
            --name)         OPT_NAME="$2";                     shift 2 ;;
            --server)       OPT_SERVER="$2";                   shift 2 ;;
            --runtime)      OPT_SERVER="$2";                   shift 2 ;;  # alias of --server
            --server-version) OPT_SERVER_VERSION="$2";         shift 2 ;;
            --as)           OPT_AS="$2";                       shift 2 ;;
            --cpu)          OPT_CPU="$2";                      shift 2 ;;
            --memory)       OPT_MEMORY="$2";                   shift 2 ;;
            --replicas)     require_int replicas "$2"; OPT_REPLICAS="$2"; shift 2 ;;
            --tp)           require_int tp "$2"; OPT_TP="$2";  shift 2 ;;
            --cpu-policy)   OPT_CPU_POLICY="${2,,}";           shift 2 ;;
            --category)     OPT_CATEGORY="$2";                 shift 2 ;;
            --routing)      OPT_ROUTING="$2";                  shift 2 ;;
            --node)         OPT_NODE="$2";                     shift 2 ;;
            --env)          EXTRA_ENV+=("$2");                 shift 2 ;;
            --arg)          EXTRA_ARGS+=("$2");                shift 2 ;;
            --label)        require_label "$2"; EXTRA_LABELS+=("$2"); shift 2 ;;
            -h|--help)      usage; exit 0 ;;
            -v|--version)   echo "model-manager $MM_VERSION"; exit 0 ;;
            --)             shift; POSITIONAL+=("$@"); break ;;
            -*)             abort "Unknown option: $1" ;;
            *)              POSITIONAL+=("$1");                 shift ;;
        esac
    done
}

# Cluster-internal URL used for LiteLLM api_base registration.
# Includes the OpenAI-compatible API version so LiteLLM can append /chat/completions.
#
# Resolution order:
#   1. MM_LITELLM_KSERVE_URL env — explicit override, appends /<ns>/<name>/<vN>
#   2. LLMInferenceService (vLLM) → AI Gateway service (routes to EPP + workload)
#      Path convention matches AIGatewayRoute: /<ns>/<name>/v1
#   3. InferenceService (OVMS)   → direct predictor service (no gateway hop)
#   4. Fallback if gateway svc missing → direct predictor service
model_internal_url() {
    local api_version="v1"

    # Operator override.
    if [[ -n "${MM_LITELLM_KSERVE_URL:-}" ]]; then
        echo "${MM_LITELLM_KSERVE_URL%/}/${MODEL_NAMESPACE}/${MODEL_NAME}/${api_version}"
        return
    fi

    # OVMS: LiteLLM talks direct to the predictor service.
    if [[ "$MODEL_KIND" == "InferenceService" ]]; then
        local port
        port=$(kubectl get svc "${MODEL_NAME}-predictor" -n "$MODEL_NAMESPACE" \
            -o jsonpath='{.spec.ports[0].port}' 2>/dev/null) || true
        [[ -z "$port" ]] && port=80
        echo "http://${MODEL_NAME}-predictor.${MODEL_NAMESPACE}.svc.cluster.local:${port}/${api_version}"
        return
    fi

    # LLMInferenceService: route via the AI Gateway that KServe attached its
    # per-model HTTPRoute to (default: `ai-gateway` in `envoy-gateway-system`).
    # This lets EPP do KV-cache-aware routing across replicas — same path an
    # external client would take, minus the auth filter on the public listener.
    local gw_ns="${MM_INFERENCE_GATEWAY_NS:-envoy-gateway-system}"
    local gw_name="${MM_INFERENCE_GATEWAY:-ai-gateway}"
    local gw_svc
    gw_svc=$(kubectl get svc "$gw_name" -n "$gw_ns" \
        -o jsonpath='{.metadata.name}' 2>/dev/null) || true

    if [[ -n "$gw_svc" ]]; then
        echo "http://${gw_svc}.${gw_ns}.svc.cluster.local/${MODEL_NAMESPACE}/${MODEL_NAME}/${api_version}"
        return
    fi

    # Fallback: gateway service not discoverable — hit the workload directly.
    warn "AI Gateway service '$gw_name' not found in $gw_ns — LiteLLM will bypass gateway for $MODEL_NAME"
    echo "http://${MODEL_NAME}-kserve-workload-svc.${MODEL_NAMESPACE}.svc.cluster.local:8000/${api_version}"
}

on_model_ready() {
    ok "$MODEL_NAME is Ready"
    # Patch the InferencePool to Accepted here (idempotent) so the gateway
    # route goes live. Done at ready-time — not fire-and-forget at apply-time —
    # so it can't race ahead of the pool CR being created.
    [[ "$MODEL_KIND" == "LLMInferenceService" ]] && patch_pool_status "$MODEL_NAME" "$MODEL_NAMESPACE"
    litellm_register "$MODEL_NAME" "$(model_internal_url)"
}

# ── Model resolution (catalog or ad-hoc) ─────────────────────────────────────
resolve_target() {
    local target="${1:-}"
    load_config "$MM_CONFIG"

    if [[ -n "$OPT_ID" ]]; then
        MODEL_ID="$OPT_ID"
        MODEL_NAME="${OPT_NAME:-$(echo "$MODEL_ID" | sed 's|.*/||; s|[^a-zA-Z0-9]|-|g' | tr '[:upper:]' '[:lower:]')}"
        MODEL_KIND=""
        # Server binding for ad-hoc: --server (or --runtime alias) wins, else default.
        MODEL_RUNTIME="${OPT_SERVER:-$DEFAULT_RUNTIME}"
        MODEL_NAMESPACE="$DEFAULT_NAMESPACE"
        MODEL_REPLICAS="${OPT_REPLICAS:-$DEFAULT_REPLICAS}"
        MODEL_CPU="$OPT_CPU"
        MODEL_MEMORY="$OPT_MEMORY"
        MODEL_CATEGORY="$OPT_CATEGORY"
        MODEL_IMAGE=""
        MODEL_NODE="$OPT_NODE"
        MODEL_ROUTING=""
        # Ad-hoc deploys have no catalog entry, so version + per-model args/env
        # come only from CLI flags. --server-version feeds MODEL_SERVER_VERSION
        # directly (no servers: allow-list to check); build_* read the JSON vars.
        MODEL_SERVER_VERSION="${OPT_SERVER_VERSION:-}"
        MODEL_ARGS_JSON="[]"
        MODEL_ENV_JSON="{}"
    elif [[ -n "$target" && "$target" != "all" ]]; then
        resolve_model "$target"
    elif [[ "$target" == "all" ]]; then
        return 0
    else
        abort "No model specified. Use: model-manager <command> <model-name> or --id <hf/repo>"
    fi

    load_runtime "$MODEL_RUNTIME"
    [[ -z "$MODEL_KIND" ]] && MODEL_KIND="$RUNTIME_KIND"

    # Track whether routing was chosen explicitly (models.yaml or CLI) — if not,
    # we're free to apply category-based downgrades below without surprising the user.
    local routing_is_explicit=false
    [[ -n "$MODEL_ROUTING" || -n "$OPT_ROUTING" ]] && routing_is_explicit=true

    # --category overrides the catalog/auto-detected category. Must land before
    # apply_category_defaults, which keys off MODEL_CATEGORY for args + resources.
    [[ -n "$OPT_CATEGORY" ]] && MODEL_CATEGORY="$OPT_CATEGORY"

    if [[ -z "$MODEL_CATEGORY" ]]; then
        MODEL_CATEGORY=$(detect_category "$MODEL_ID")
        info "Category: $MODEL_CATEGORY (auto-detected)"
    fi

    apply_category_defaults
    [[ -n "$OPT_CPU"      ]] && MODEL_CPU="$OPT_CPU"
    [[ -n "$OPT_MEMORY"   ]] && MODEL_MEMORY="$OPT_MEMORY"
    [[ -n "$OPT_REPLICAS" ]] && MODEL_REPLICAS="$OPT_REPLICAS"
    [[ -n "$OPT_NODE"     ]] && MODEL_NODE="$OPT_NODE"

    # Routing precedence (highest wins):
    #   1. --routing CLI flag
    #   2. models.yaml `routing:` field
    #   3. category downgrade — embed/rerank have no KV cache; EPP is useless
    #   4. runtime default (values.yaml `routing:`)
    if [[ -n "$OPT_ROUTING" ]]; then
        MODEL_ROUTING="$OPT_ROUTING"
    elif [[ "$routing_is_explicit" == false ]] \
        && [[ "$MODEL_CATEGORY" == "embed" || "$MODEL_CATEGORY" == "rerank" ]]; then
        MODEL_ROUTING="direct"
    elif [[ -z "$MODEL_ROUTING" ]]; then
        MODEL_ROUTING="${RUNTIME_ROUTING:-}"
    fi

    MODEL_IMAGE="${MODEL_IMAGE:-$RUNTIME_IMAGE}"

    # --as <name>: deploy this model under a distinct resource name, so multiple
    # (server, version) variants of the same catalog model can run concurrently
    # without colliding on one LLMInferenceService. The alias becomes the k8s
    # resource name, routing key, served-model-name, and weights path (weights
    # are re-fetched under the alias — correct and isolated, not shared).
    if [[ -n "$OPT_AS" ]]; then
        MODEL_NAME="$OPT_AS"
    fi
    MODEL_URI="pvc://${STORAGE_PVC_NAME:-model-store}/$MODEL_NAME"
}

# Lightweight variant for status-all iteration.
resolve_target_quick() {
    resolve_model "$1"
    load_runtime "$MODEL_RUNTIME"
    [[ -z "$MODEL_KIND" ]] && MODEL_KIND="$RUNTIME_KIND"
}

# ── Manifest rendering ───────────────────────────────────────────────────────
# The manifest is a template with placeholders for env/args/affinity/NRI blocks.
# Each block is built by a helper and passed to render_template.

# True when the effective engine args for this model include --trust-remote-code,
# from ANY layer — category defaults, version delta, per-model args, or --arg CLI.
# It is a normal vLLM flag, so it needs no dedicated option; but when present it
# has two side effects the deploy must arrange: the download job prefetches the
# repo's custom modeling code (see download_weights), and the serving pod is
# pinned offline (HF_HUB_OFFLINE=1, see build_env_block) so vLLM loads that
# prefetched code instead of reaching the Hub at runtime.
model_uses_trust_remote_code() {
    local rj
    rj=$(runtime_json "$MODEL_RUNTIME")
    local declared
    declared=$(jq -cn \
        --argjson cat "$(jq -c --arg c "$MODEL_CATEGORY" '.categories[$c].args // []' <<< "$rj")" \
        --argjson ver "$RUNTIME_VERSION_ARGS_JSON" \
        --argjson model "$MODEL_ARGS_JSON" \
        '$cat + $ver + $model')
    jq -e 'index("--trust-remote-code") != null' <<< "$declared" >/dev/null 2>&1 && return 0
    local a
    for a in "${EXTRA_ARGS[@]}"; do
        [[ "$a" == "--trust-remote-code" ]] && return 0
    done
    return 1
}

# Env block. Precedence (lowest → highest), all deduped into one map so a
# higher layer replaces rather than appends a duplicate env name:
#   trust-remote-code default → runtime shared .env → category env →
#   version env delta → models.yaml per-model env → --env CLI
# then runtime-specific extras (openvino proxy + HF token) that aren't plain values.
build_env_block() {
    local rj
    rj=$(runtime_json "$MODEL_RUNTIME")
    local kv_gb
    kv_gb=$(jq -r --arg c "$MODEL_CATEGORY" '.categories[$c].defaults.kv_cache_gb // 8' <<< "$rj" 2>/dev/null)

    # CLI --env pairs → JSON object (highest-priority layer).
    local extra_json="{}" pair
    for pair in "${EXTRA_ENV[@]}"; do
        extra_json=$(jq -c --arg k "${pair%%=*}" --arg v "${pair#*=}" '. + {($k): $v}' <<< "$extra_json")
    done

    # --trust-remote-code implies serving offline so vLLM uses the custom modeling
    # code prefetched by the download job (not the Hub). Seeded as the LOWEST layer
    # so any explicit config still wins (e.g. --env HF_HUB_OFFLINE=0 to override).
    local trc_json="{}"
    model_uses_trust_remote_code && trc_json='{"HF_HUB_OFFLINE":"1"}'

    # Merge the layers; `*` is right-biased so later operands win on key clash.
    # NB: reference the JSON vars directly — a `${v:-{}}` brace-default would be
    # mangled by bash parameter expansion. They're always initialized upstream.
    # Category env sits above the shared runtime .env so a category can set (or
    # override) a value like VLLM_CPU_KVCACHE_SPACE for just its workload class.
    local merged
    merged=$(jq -cn \
        --argjson trc "$trc_json" \
        --argjson base "$(jq -c '.env // {}' <<< "$rj")" \
        --argjson cat "$(jq -c --arg c "$MODEL_CATEGORY" '.categories[$c].env // {}' <<< "$rj")" \
        --argjson ver "$RUNTIME_VERSION_ENV_JSON" \
        --argjson model "$MODEL_ENV_JSON" \
        --argjson extra "$extra_json" \
        '$trc * $base * $cat * $ver * $model * $extra')

    local out="" key val
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" ]] && continue
        val=$(jq -r --arg k "$key" '.[$k]' <<< "$merged")
        val="${val//\$\{KV_CACHE_GB\}/$kv_gb}"
        out+="        - name: $key
          value: \"$val\"
"
    done < <(jq -r 'keys[]' <<< "$merged")

    # OpenVINO fetches weights inside the serving pod, so it needs proxy + HF token there.
    if [[ "$MODEL_RUNTIME" == "openvino" ]]; then
        _append_env() {
            [[ -z "$2" ]] && return 0
            out+="        - name: $1
          value: \"$2\"
"
        }
        _append_env HTTP_PROXY  "${MM_HTTP_PROXY:-}"
        _append_env http_proxy  "${MM_HTTP_PROXY:-}"
        _append_env HTTPS_PROXY "${MM_HTTPS_PROXY:-}"
        _append_env https_proxy "${MM_HTTPS_PROXY:-}"
        _append_env NO_PROXY    "${MM_NO_PROXY:-}"
        _append_env no_proxy    "${MM_NO_PROXY:-}"
        unset -f _append_env

        [[ -n "${HF_TOKEN:-}" ]] && out+="        - name: HF_TOKEN
          valueFrom:
            secretKeyRef:
              name: hf-token
              key: token
"
    fi

    # CLI --env is already folded into the merged map above. Emit a leading
    # newline before the list items, or an inline empty list `[]` when there are
    # none — so the rendered manifest never produces `env: null` (which k8s
    # rejects: "env in body must be of type array").
    if [[ -z "$out" ]]; then printf '[]'; else printf '\n%s' "${out%$'\n'}"; fi
}

# ── Chat template plumbing ───────────────────────────────────────────────────
# A models.yaml `chat_template:` is either an absolute path to a file that already
# exists in the pod, or inline Jinja. Inline Jinja must not appear anywhere in the
# LLMInferenceService spec (the KServe controller runs the spec through Go
# text/template and chokes on `{{ }}` — see apply_chat_template_cm), so it is
# carried in a ConfigMap mounted read-only at CHAT_TEMPLATE_MOUNT_PATH and the
# spec references only the resulting path.
CHAT_TEMPLATE_MOUNT_PATH="/etc/chat-template"

# ConfigMap name for a model's inline template. Derived from the DEPLOYED name so
# `--as <alias>` variants get their own ConfigMap instead of fighting over one.
chat_template_cm_name() { echo "${MODEL_NAME}-chat-template"; }

# The value handed to vLLM's --chat-template: the user's path verbatim, or the
# mount path of the generated ConfigMap.
chat_template_path() {
    if [[ "${MODEL_CHAT_TEMPLATE_IS_FILE:-false}" == true ]]; then
        printf '%s' "$MODEL_CHAT_TEMPLATE"
    else
        printf '%s/chat_template.jinja' "$CHAT_TEMPLATE_MOUNT_PATH"
    fi
}

# True when a generated ConfigMap volume is needed: a template is set AND it is
# inline Jinja rather than a path to an already-present file.
chat_template_needs_volume() {
    [[ -n "${MODEL_CHAT_TEMPLATE:-}" && "${MODEL_CHAT_TEMPLATE_IS_FILE:-false}" != true ]]
}

# Build the two manifest fragments: a volumeMounts entry on the serving container
# and the backing volumes entry on the pod spec.
#
# Sets globals rather than echoing, mirroring build_nri_annotations: each fragment
# must carry its own trailing newline, and a command substitution would strip it.
# The template pins the following key immediately after the placeholder
# (`{{CHAT_TEMPLATE_MOUNT}}        resources:`), so an unset template renders the
# surrounding manifest byte-for-byte unchanged.
CHAT_TEMPLATE_MOUNT=""
CHAT_TEMPLATE_VOLUME=""
build_chat_template_blocks() {
    CHAT_TEMPLATE_MOUNT=""
    CHAT_TEMPLATE_VOLUME=""
    chat_template_needs_volume || return 0
    CHAT_TEMPLATE_MOUNT="        volumeMounts:
          - name: chat-template
            mountPath: ${CHAT_TEMPLATE_MOUNT_PATH}
            readOnly: true
"
    CHAT_TEMPLATE_VOLUME="    volumes:
      - name: chat-template
        configMap:
          name: $(chat_template_cm_name)
"
}

# Args block. Precedence (lowest → highest), deduped by flag name so a higher
# layer REPLACES rather than appends — the emitted list matches vLLM's
# last-wins runtime semantics but the CRD carries only one occurrence:
#   category defaults → version args delta → models.yaml per-model args
#   → --served-model-name / --chat-template → --arg CLI
build_args_block() {
    local rj
    rj=$(runtime_json "$MODEL_RUNTIME")

    # NB: OVMS args come entirely from the ClusterServingRuntime (--config_path);
    # the InferenceService adds none. The model is pre-exported to IR by the prep
    # job, so no --source_model here.

    # Concatenate every source into one JSON array, low-precedence first.
    local all_json
    all_json=$(jq -cn \
        --argjson cat "$(jq -c --arg c "$MODEL_CATEGORY" '.categories[$c].args // []' <<< "$rj")" \
        --argjson ver "$RUNTIME_VERSION_ARGS_JSON" \
        --argjson model "$MODEL_ARGS_JSON" \
        '$cat + $ver + $model')

    if [[ "$MODEL_KIND" == "LLMInferenceService" ]]; then
        all_json=$(jq -c --arg n "$MODEL_NAME" '. + ["--served-model-name", $n]' <<< "$all_json")
        # Optional per-model chat template (models.yaml: chat_template).
        # Either form resolves to a PATH here, never to inline Jinja: an absolute
        # path is passed through untouched, while inline Jinja is written to a
        # ConfigMap and mounted at CHAT_TEMPLATE_MOUNT_PATH. Keeping Jinja out of
        # the spec is mandatory — the KServe controller would otherwise run it
        # through Go text/template and refuse to reconcile (see
        # apply_chat_template_cm). Placed before EXTRA_ARGS so a user
        # --arg "--chat-template=..." still wins.
        if [[ -n "${MODEL_CHAT_TEMPLATE:-}" ]]; then
            all_json=$(jq -c --arg t "$(chat_template_path)" \
                '. + ["--chat-template", $t]' <<< "$all_json")
        fi
    fi

    # EXTRA_ARGS from --arg CLI — highest precedence.
    if (( ${#EXTRA_ARGS[@]} > 0 )); then
        local extra_json
        extra_json=$(printf '%s\n' "${EXTRA_ARGS[@]}" | jq -Rc '[inputs]')
        all_json=$(jq -c --argjson e "$extra_json" '. + $e' <<< "$all_json")
    fi

    # Dedupe by flag name, keeping the LAST occurrence. Recognizes three forms
    # per entry: "--flag=value" (inline), "--flag" "value" (paired, two slots),
    # "--flag" (boolean). Non-flag tokens (no leading --) are kept in place and
    # deduped by their literal value.
    local deduped_json
    deduped_json=$(jq -c '
        . as $a
        | [range(0; $a | length)]
        | reduce .[] as $i ({out: [], skip: false};
            if .skip then .skip = false
            elif ($a[$i] | test("^--[^=]+=")) then
              .out += [{key: ($a[$i] | capture("^(?<k>--[^=]+)=") | .k), tokens: [$a[$i]]}]
            elif ($a[$i] | test("^--")) then
              if ($i + 1 < ($a | length)) and (($a[$i+1] | test("^--")) | not) then
                (.out += [{key: $a[$i], tokens: [$a[$i], $a[$i+1]]}]) | .skip = true
              else
                .out += [{key: $a[$i], tokens: [$a[$i]]}]
              end
            else
              .out += [{key: $a[$i], tokens: [$a[$i]]}]
            end
          )
        | .out
        | reverse
        | reduce .[] as $e ({seen: {}, out: []};
            if .seen[$e.key] then . else (.seen[$e.key] = true | .out += [$e]) end
          )
        | .out
        | reverse
        | map(.tokens[])
    ' <<< "$all_json")

    # Emit YAML list items. yaml_quote uses jq @json so values with special
    # characters (spaces, quotes, backslashes) render as valid YAML scalars.
    local out="" arg
    while IFS= read -r arg; do
        out+="        - $(yaml_quote "$arg")
"
    done < <(jq -r '.[]' <<< "$deduped_json")

    # Leading newline before list items, or inline `[]` when empty — mirrors
    # build_env_block so `args:` is never rendered as null.
    if [[ -z "$out" ]]; then printf '[]'; else printf '\n%s' "${out%$'\n'}"; fi
}

# Extra metadata.labels entries from --label, appended under the built-in labels.
# Leading newline per entry and none trailing — same idiom as build_args_block,
# because `$(...)` strips trailing newlines but not leading ones. The templates
# therefore put {{EXTRA_LABELS}} at the end of the last built-in label line.
build_labels_block() {
    local out="" pair
    for pair in "${EXTRA_LABELS[@]}"; do
        out+=$'\n'"    ${pair%%=*}: $(yaml_quote "${pair#*=}")"
    done
    printf '%s' "$out"
}

# Optional nodeAffinity block.
# Includes soft preference for --node and hard NRI max-tp requirement when applicable.
# When require_amx is enabled, adds a hard requirement for AMX-capable nodes (NFD label).
build_affinity_block() {
    local has_node_pref=false has_nri_req=false has_amx_req=false
    [[ -n "$MODEL_NODE" ]] && has_node_pref=true
    [[ -n "${NRI_NODE_SELECTOR_TERM:-}" ]] && has_nri_req=true
    [[ "${DEFAULT_REQUIRE_AMX:-false}" =~ ^(true|1|yes)$ ]] && has_amx_req=true

    [[ "$has_node_pref" == false && "$has_nri_req" == false && "$has_amx_req" == false ]] && return 0

    echo "    affinity:"
    echo "      nodeAffinity:"

    if [[ "$has_nri_req" == true || "$has_amx_req" == true ]]; then
        echo "        requiredDuringSchedulingIgnoredDuringExecution:"
        echo "          nodeSelectorTerms:"
        echo "            - matchExpressions:"

        if [[ "$has_nri_req" == true ]]; then
            local tp_val
            tp_val=$(echo "$NRI_NODE_SELECTOR_TERM" | jq -r '.matchExpressions[0].values[0]' 2>/dev/null) || true
            [[ -z "$tp_val" ]] && tp_val="0"
            cat <<EOFNRI
                - key: nri.intel.com/max-tp
                  operator: Gt
                  values:
                    - "${tp_val}"
EOFNRI
        fi

        if [[ "$has_amx_req" == true ]]; then
            cat <<EOFAMX
                - key: feature.node.kubernetes.io/cpu-cpuid.AMXBF16
                  operator: In
                  values:
                    - "true"
EOFAMX
        fi
    fi

    if [[ "$has_node_pref" == true ]]; then
        cat <<EOFPREF
        preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            preference:
              matchExpressions:
                - key: kubernetes.io/hostname
                  operator: In
                  values:
                    - ${MODEL_NODE}
          - weight: 50
            preference:
              matchExpressions:
                - key: node-role.kubernetes.io/control-plane
                  operator: DoesNotExist
EOFPREF
    fi
}

# Resolve TP size from --tp flag or --arg list; inject into EXTRA_ARGS if needed.
# Must run in the parent shell (not command substitution) — mutates EXTRA_ARGS.
# Sets: TP_SIZE
resolve_tp_size() {
    local i
    TP_SIZE=1
    if [[ -n "$OPT_TP" ]]; then
        TP_SIZE="$OPT_TP"
        for (( i=0; i<${#EXTRA_ARGS[@]}; i++ )); do
            [[ "${EXTRA_ARGS[$i]}" == "--tensor-parallel-size" ]] && return
        done
        EXTRA_ARGS+=("--tensor-parallel-size" "$OPT_TP")
        return
    fi
    for (( i=0; i<${#EXTRA_ARGS[@]}; i++ )); do
        if [[ "${EXTRA_ARGS[$i]}" == "--tensor-parallel-size" ]]; then
            TP_SIZE="${EXTRA_ARGS[$((i+1))]:-1}"; return
        fi
    done
}

# Populate NRI_ANNOTATIONS and NRI_NODE_SELECTOR_TERM.
# Uses release-1 NRI policy approach via Python for reliable balloon naming,
# effective CPU calculation, and comprehensive pre-flight validation.
build_nri_annotations() {
    local tp_size="$1"
    NRI_ANNOTATIONS=""
    NRI_NODE_SELECTOR_TERM=""

    [[ ! "${MM_NRI_ENABLED:-true}" =~ ^(true|1|yes)$ ]] && return 0

    # NOTE: pre-flight is intentionally NOT run here. build_nri_annotations is
    # invoked inside a command substitution (manifest=$(render_manifest)), so a
    # blocking gate placed here could neither abort the parent deploy nor print
    # cleanly. The enforcing gate runs in cmd_deploy via nri_preflight_gate,
    # before any manifest is applied.

    # Resolve NRI settings: balloon name, effective CPU, annotations
    nri_resolve "$MODEL_CPU" "$tp_size" "$MODEL_NODE" "$MODEL_KIND" "${OPT_BALLOON_TYPE:-}"

    # Update CPU in manifest to effective value (doubled when HT hidden under NRI)
    if [[ "$NRI_EFFECTIVE_CPU" -gt 0 && "$NRI_EFFECTIVE_CPU" != "$MODEL_CPU" ]]; then
        info "NRI: Effective CPU ${MODEL_CPU} → ${NRI_EFFECTIVE_CPU} (hideHyperthreads active)" >&2
        MODEL_CPU="$NRI_EFFECTIVE_CPU"
    fi
}

# Enforcing NRI pre-flight gate. Runs the physical-core budget / NUMA-fit check
# and ABORTS the deploy when it fails, so a model is never admitted onto a node
# whose physical-core pool cannot hold it (which would make NRI spill the vLLM
# balloon onto reserved hyperthread-sibling cores).
#
# Honours the same overrides the check itself does:
#   MM_NRI_ENABLED=false      — NRI disabled entirely; gate is a no-op.
#   MM_NRI_SKIP_PREFLIGHT=1   — check skipped (nri_policy.py returns pass).
#   MM_NRI_PREFLIGHT=warn     — failures reported but do NOT block (legacy
#                               best-effort behaviour, opt-in).
# In the default mode a failure aborts before any weights download or manifest
# apply. Called from cmd_deploy, outside the render_manifest command
# substitution, so `die` can terminate the process cleanly.
nri_preflight_gate() {
    [[ "${MM_NRI_ENABLED:-true}" =~ ^(true|1|yes)$ ]] || return 0

    resolve_tp_size   # sets TP_SIZE (idempotent; also called in render_manifest)

    if nri_preflight "$MODEL_CPU" "$TP_SIZE" "$MODEL_NODE" "${MODEL_REPLICAS:-1}"; then
        return 0
    fi

    # nri_preflight already printed the specific error lines.
    abort "NRI pre-flight failed: not enough physical cores to place ${MODEL_NAME}" \
          "(cpu=${MODEL_CPU} tp=${TP_SIZE} replicas=${MODEL_REPLICAS:-1}) without spilling" \
          "onto reserved hyperthread-sibling cores. Lower --cpu/--replicas, raise --tp," \
          "undeploy a model, or add a node. Override with MM_NRI_PREFLIGHT=warn (proceed" \
          "anyway) or MM_NRI_SKIP_PREFLIGHT=1 (skip check)."
}

render_manifest() {
    local env_block args_block affinity_block labels_block
    resolve_tp_size                      # mutates EXTRA_ARGS; sets TP_SIZE
    env_block=$(build_env_block)
    args_block=$(build_args_block)
    labels_block=$(build_labels_block)
    # NB: ordering is deliberately unchanged from the NRI-only version —
    # build_affinity_block runs BEFORE the policy block, so the hard max-tp
    # nodeAffinity that build_cpu_policy_annotations would set via
    # NRI_NODE_SELECTOR_TERM is (as before) not emitted here. Moving the policy
    # call earlier would newly activate a required nodeAffinity on existing
    # TP>1 NRI deploys and strand them Pending on clusters whose nodes lack the
    # nri.intel.com/max-tp label. Left as-is on purpose; see the deploy notes.
    affinity_block=$(build_affinity_block)
    build_cpu_policy_annotations "$TP_SIZE"   # sets CPU_POLICY_ANNOTATIONS
    build_chat_template_blocks           # sets CHAT_TEMPLATE_MOUNT / _VOLUME

    case "$MODEL_KIND" in
        LLMInferenceService)
            render_template "$MM_TEMPLATES/llm-inference-service.yaml" \
                "MODEL_NAME=$MODEL_NAME" "NAMESPACE=$MODEL_NAMESPACE" \
                "IMAGE=$MODEL_IMAGE" "CPU=$MODEL_CPU" "MEMORY=$MODEL_MEMORY" \
                "REPLICAS=$MODEL_REPLICAS" "MODEL_URI=$MODEL_URI" \
                "ARGS=$args_block" "ENV=$env_block" \
                "NRI_ANNOTATIONS=$CPU_POLICY_ANNOTATIONS" \
                "GATEWAY_NAME=${MM_INFERENCE_GATEWAY:-ai-gateway}" \
                "GATEWAY_NAMESPACE=${MM_INFERENCE_GATEWAY_NS:-llm-inference}" \
                "CHAT_TEMPLATE_MOUNT=$CHAT_TEMPLATE_MOUNT" \
                "CHAT_TEMPLATE_VOLUME=$CHAT_TEMPLATE_VOLUME" \
                "AFFINITY=$affinity_block" \
                "EXTRA_LABELS=$labels_block"
            ;;
        InferenceService)
            local template="$MM_TEMPLATES/inference-service.yaml"
            [[ "$MODEL_RUNTIME" == "openvino" ]] && template="$MM_TEMPLATES/inference-service-ovms.yaml"
            render_template "$template" \
                "MODEL_NAME=$MODEL_NAME" "NAMESPACE=$MODEL_NAMESPACE" \
                "MODEL_ID=$MODEL_ID" \
                "MODEL_FORMAT=${RUNTIME_FORMAT:-openvino}" "MODEL_URI=$MODEL_URI" \
                "PVC_NAME=${STORAGE_PVC_NAME:-model-store}" \
                "RUNTIME_NAME=${RUNTIME_NAME:-$MODEL_RUNTIME-runtime}" \
                "CPU=$MODEL_CPU" "MEMORY=$MODEL_MEMORY" "REPLICAS=$MODEL_REPLICAS" \
                "ARGS=$args_block" "ENV=$env_block" "AFFINITY=$affinity_block" \
                "NRI_ANNOTATIONS=$CPU_POLICY_ANNOTATIONS" \
                "EXTRA_LABELS=$labels_block"
            ;;
        *) abort "Unknown model kind: $MODEL_KIND" ;;
    esac
}

# ── Download job (HuggingFace → PVC) ─────────────────────────────────────────
download_weights() {
    check_network

    # Refuse to download a gated model without an HF_TOKEN.
    if [[ -z "${HF_TOKEN:-}" ]]; then
        local proxy_args=()
        [[ -n "${MM_HTTPS_PROXY:-}" ]] && proxy_args=(--proxy "$MM_HTTPS_PROXY")
        local gated
        gated=$(curl -sf --max-time 10 "${proxy_args[@]}" \
            "https://huggingface.co/api/models/$MODEL_ID" 2>/dev/null \
            | jq -r '.gated // empty' 2>/dev/null) || true
        if [[ -n "$gated" && "$gated" != "false" ]]; then
            abort "Model '$MODEL_ID' is gated. Set HF_TOKEN with an authorized token."
        fi
    fi

    info "Downloading model weights: $MODEL_ID → PVC:/$MODEL_NAME"

    if [[ -n "${HF_TOKEN:-}" ]]; then
        kubectl create secret generic hf-token -n "$MODEL_NAMESPACE" \
            --from-literal=token="$HF_TOKEN" --dry-run=client -o yaml \
            | kubectl apply -f - >/dev/null 2>&1
    fi

    # The downloader runs as a non-root uid with no writable HOME (defaults to
    # "/"), so huggingface_hub/hf_xet fall back to /.cache and fail with
    # "Permission denied". Point HOME and the HF caches at the mounted PVC
    # (/models is writable via the job's fsGroup), so cache + weights share the
    # volume and the download succeeds.
    local env_entries="
            - name: HOME
              value: \"/models\"
            - name: HF_HOME
              value: \"/models/.hf-cache\""
    [[ -n "${HF_TOKEN:-}" ]] && env_entries+="
            - name: HF_TOKEN
              valueFrom:
                secretKeyRef:
                  name: hf-token
                  key: token"
    _append_proxy() {
        [[ -z "$2" ]] && return 0
        env_entries+="
            - name: $1
              value: \"$2\""
    }
    _append_proxy HTTP_PROXY  "${MM_HTTP_PROXY:-}"
    _append_proxy http_proxy  "${MM_HTTP_PROXY:-}"
    _append_proxy HTTPS_PROXY "${MM_HTTPS_PROXY:-}"
    _append_proxy https_proxy "${MM_HTTPS_PROXY:-}"
    _append_proxy NO_PROXY    "${MM_NO_PROXY:-}"
    _append_proxy no_proxy    "${MM_NO_PROXY:-}"
    unset -f _append_proxy

    local env_block=""
    [[ -n "$env_entries" ]] && env_block="          env:$env_entries"

    local downloader_image="${RUNTIME_DOWNLOADER_IMAGE:-$RUNTIME_IMAGE}"

    # Engine-aware prep command (guarded by a sentinel so re-deploys are no-ops).
    #   openvino: `ovms --pull` (latest-py image, has optimum-cli built in)
    #             downloads + converts/quantizes to OpenVINO IR + graph.pbtxt, then
    #             we relocate the servable to /models/<name>/ and write the OVMS
    #             config_all.json registry there. The light serving image then
    #             serves it via --config_path with no download/conversion.
    #   others  : plain `hf download` of raw weights (vLLM reads safetensors).
    local dl_cmd sentinel="/models/$MODEL_NAME/.download_complete"
    if [[ "$MODEL_RUNTIME" == "openvino" ]]; then
        local stage="/models/.pull-$MODEL_NAME" dest="/models/$MODEL_NAME"
        # --weight-format is a CONVERSION knob: `ovms --pull` accepts it only when
        # it must convert a source model (e.g. raw-HF safetensors) to OpenVINO IR.
        # Pre-converted OpenVINO/* repos are already IR and REJECT the flag ("...
        # unsupported for OpenVINO models"). So it is opt-in: set
        # runtimes.openvino.categories.<cat>.weight_format to quantize raw weights;
        # leave it empty (the default) to pull an already-converted model as-is.
        local ov_wf ov_wf_flag=""
        ov_wf=$(runtime_json "$MODEL_RUNTIME" | jq -r --arg c "$MODEL_CATEGORY" '.categories[$c].weight_format // empty')
        [[ -n "$ov_wf" ]] && ov_wf_flag=" --weight-format $ov_wf"
        dl_cmd="set -e
export HOME=/models HF_HOME=/models/.hf-cache
if [ -f $sentinel ]; then echo 'Model already prepared, skipping'; exit 0; fi
rm -rf '$stage'; mkdir -p '$stage'
ovms --pull --source_model '$MODEL_ID' --model_repository_path '$stage' --model_name '$MODEL_NAME' --task text_generation${ov_wf_flag} --target_device ${MM_OVMS_TARGET_DEVICE:-CPU}
graph_dir=\$(dirname \$(find '$stage' -name graph.pbtxt | head -1))
if [ -z \"\$graph_dir\" ]; then echo 'ERROR: pull produced no graph.pbtxt'; exit 1; fi
rm -rf '$dest'; mkdir -p '$dest'
mv \"\$graph_dir\"/* '$dest'/
rm -rf '$stage'
printf '%s\\n' '{ \"mediapipe_config_list\": [ { \"name\": \"$MODEL_NAME\", \"base_path\": \".\" } ], \"model_config_list\": [] }' > '$dest/config_all.json'
touch $sentinel
echo \"Prepared OVMS servable + config_all.json at $dest\""
    else
        # trust-remote-code models load custom modeling code referenced from
        # config.json's `auto_map` (values like "someorg/repo--module.Class").
        # For offline serving (HF_HUB_OFFLINE=1, set in build_env_block) that code
        # must be on the PVC, so prefetch the `.py` from each referenced repo and
        # rewrite auto_map to drop the `repo--` prefix → plain "module.Class" that
        # resolves against the local dir. No-op when the model has no auto_map.
        local trc_prefetch=""
        if model_uses_trust_remote_code; then
            trc_prefetch="
cfg=/models/$MODEL_NAME/config.json
if [ -f \"\$cfg\" ]; then
  echo 'trust-remote-code: prefetching custom modeling code'
  for repo in \$(python3 -c \"import json; c=json.load(open('\$cfg')); print(chr(10).join({v.split('--')[0] for v in (c.get('auto_map') or {}).values() if '--' in v}))\"); do
    echo \"  fetching \$repo\"; hf download \"\$repo\" --local-dir /models/$MODEL_NAME --include '*.py'
  done
  python3 -c \"import json; p='\$cfg'; c=json.load(open(p)); am=c.get('auto_map') or {}; c['auto_map']={k:(v.split('--')[-1] if '--' in v else v) for k,v in am.items()}; json.dump(c,open(p,'w'),indent=2)\"
  echo '  patched auto_map for offline load'
fi"
        fi
        dl_cmd="set -e
export HOME=/tmp HF_HOME=/tmp/.hf XDG_CACHE_HOME=/tmp/.cache PIP_CACHE_DIR=/tmp/.pip
if [ -f $sentinel ]; then echo 'Weights already present, skipping download'; exit 0; fi
command -v hf >/dev/null 2>&1 || pip install -q huggingface_hub[hf_xet]
hf download '$MODEL_ID' --local-dir /models/$MODEL_NAME$trc_prefetch
touch $sentinel"
    fi

    # uid/gid = serving pod's (OVMS 5000, vLLM 1000) so prepared files are readable.
    local job_uid=1000 job_gid=1000
    [[ "$MODEL_RUNTIME" == "openvino" ]] && { job_uid=5000; job_gid=5000; }

    # Resource envelope for the download job (CWE-400: never run unbounded).
    # Plain `hf download` is network/IO-bound and light; OVMS `ovms --pull` also
    # converts/quantizes in-memory, so the memory limit tracks the model's
    # serving sizing (MODEL_MEMORY) to avoid OOM. Requests stay small so the
    # short-lived job schedules without reserving the full serving envelope.
    local dl_cpu_request="500m" dl_mem_request="2Gi"
    local dl_cpu_limit="${MODEL_CPU:-2}" dl_mem_limit="${MODEL_MEMORY:-8Gi}"

    # DOWNLOAD_CMD is embedded as a YAML block scalar (`- |`); indent each line by
    # 14 spaces to sit under the marker (tolerates arbitrary quotes/brackets).
    local dl_cmd_indented
    dl_cmd_indented=$(printf '%s\n' "$dl_cmd" | sed 's/^/              /')

    local job_yaml
    job_yaml=$(render_template "$MM_TEMPLATES/download-job.yaml" \
        "MODEL_NAME=$MODEL_NAME" "NAMESPACE=$MODEL_NAMESPACE" \
        "MODEL_ID=$MODEL_ID" "PVC_NAME=${STORAGE_PVC_NAME:-model-store}" \
        "DOWNLOADER_IMAGE=$downloader_image" "ENV_BLOCK=$env_block" \
        "DOWNLOAD_CMD=$dl_cmd_indented" "JOB_UID=$job_uid" "JOB_GID=$job_gid" \
        "DL_CPU_REQUEST=$dl_cpu_request" "DL_MEM_REQUEST=$dl_mem_request" \
        "DL_CPU_LIMIT=$dl_cpu_limit" "DL_MEM_LIMIT=$dl_mem_limit" \
        "TTL_SECONDS=${DOWNLOAD_JOB_TTL:-300}" \
        "TIMEOUT=$DOWNLOAD_TIMEOUT")

    if [[ "$DRY_RUN" == true ]]; then echo "$job_yaml"; return 0; fi

    kubectl delete job "download-$MODEL_NAME" -n "$MODEL_NAMESPACE" --ignore-not-found >/dev/null 2>&1
    kube_apply "$job_yaml"
    info "Downloading model weights: $MODEL_ID"
    info "  ${YELLOW}This may take several minutes depending on model size and your internet/proxy speed.${RESET}"
    info "  Follow progress below — do not interrupt."
    sleep 3

    stream_job_logs "$MODEL_NAMESPACE" "download-$MODEL_NAME" &
    local log_pid=$!

    if wait_job "$MODEL_NAMESPACE" "download-$MODEL_NAME" "$DOWNLOAD_TIMEOUT"; then
        kill "$log_pid" 2>/dev/null || true
        ok "Download complete: $MODEL_NAME"
        # The Job's ttlSecondsAfterFinished reaps the completed Job + pod
        # automatically, so no explicit (and CLI-lifetime-bound) cleanup here.
    else
        kill "$log_pid" 2>/dev/null || true
        local logs
        logs=$(kubectl logs -l "job-name=download-$MODEL_NAME" -n "$MODEL_NAMESPACE" --tail=20 2>/dev/null) || logs=""
        if echo "$logs" | grep -qi "401\|access denied\|gated\|authorization"; then
            abort "Download failed: model '$MODEL_ID' requires authentication. Set HF_TOKEN with an authorized token."
        elif echo "$logs" | grep -qi "ConnectError\|ConnectionError\|timeout"; then
            abort "Download failed: network error reaching HuggingFace. Check proxy settings."
        fi
        abort "Download job failed. Check logs: kubectl logs -l job-name=download-$MODEL_NAME -n $MODEL_NAMESPACE"
    fi
}

# ── Endpoint printing ────────────────────────────────────────────────────────

# Discover the ai-solutions repo root(s) to search for config files.
# Emits candidate root directories, most-specific first:
#   1. MM_GLOBAL_CONFIG_SEARCH env — colon-separated directories.
#   2. The repo this model_manager is vendored inside — found by walking up
#      from SCRIPT_DIR to the first dir containing es_auto_installer.sh.
#   3. Sibling repos matching *ai-solutions* (standalone-checkout layout).
_discover_repo_roots() {
    local roots=() root dir sibling parent_dir

    if [[ -n "${MM_GLOBAL_CONFIG_SEARCH:-}" ]]; then
        IFS=':' read -ra roots <<< "$MM_GLOBAL_CONFIG_SEARCH"
    fi

    # Vendored layout: model_manager lives inside the repo. Walk up to the
    # repo root (marked by es_auto_installer.sh).
    dir="$SCRIPT_DIR"
    while [[ "$dir" != "/" && -n "$dir" ]]; do
        if [[ -f "$dir/es_auto_installer.sh" ]]; then
            roots+=("$dir")
            break
        fi
        dir=$(dirname "$dir")
    done

    # Sibling repos matching *ai-solutions* (standalone model_manager checkout).
    parent_dir=$(dirname "$(dirname "$SCRIPT_DIR")")
    for sibling in "$parent_dir"/*ai-solutions*/; do
        [[ -d "$sibling" ]] && roots+=("${sibling%/}")
    done

    printf '%s\n' "${roots[@]}"
}

# Locate the ai-solutions global_config.yaml.
# Priority:
#   1. MM_GLOBAL_CONFIG env — explicit path.
#   2. env/local/global_config.yaml or config/defaults/global_config.yaml under
#      any discovered repo root.
# Returns empty if nothing is found.
discover_global_config() {
    [[ -n "${MM_GLOBAL_CONFIG:-}" && -f "$MM_GLOBAL_CONFIG" ]] && { echo "$MM_GLOBAL_CONFIG"; return; }

    local sub_paths=(
        "env/local/global_config.yaml"
        "config/defaults/global_config.yaml"
    )
    local root sub
    while IFS= read -r root; do
        [[ -z "$root" ]] && continue
        for sub in "${sub_paths[@]}"; do
            [[ -f "$root/$sub" ]] && { echo "$root/$sub"; return; }
        done
    done < <(_discover_repo_roots)
}

# Locate the inference solution config (config.inference.yaml). This is the
# canonical home for inference switches such as ai_gateway_provider.
# Priority:
#   1. MM_INFERENCE_CONFIG env — explicit path.
#   2. env/local/config.inference.yaml (live env) under any discovered repo root.
#   3. ext/enterprise.ai-inference/config.yaml (shipped defaults).
# Returns empty if nothing is found.
discover_inference_config() {
    [[ -n "${MM_INFERENCE_CONFIG:-}" && -f "$MM_INFERENCE_CONFIG" ]] && { echo "$MM_INFERENCE_CONFIG"; return; }

    local sub_paths=(
        "env/local/config.inference.yaml"
        "ext/enterprise.ai-inference/config.yaml"
    )
    local root sub
    while IFS= read -r root; do
        [[ -z "$root" ]] && continue
        for sub in "${sub_paths[@]}"; do
            [[ -f "$root/$sub" ]] && { echo "$root/$sub"; return; }
        done
    done < <(_discover_repo_roots)
}

# The host that serves the OpenAI-compatible API depends on the auth mode:
#   keycloak → inference.<domain>, the Gateway route Keycloak enforces JWT on.
#   litellm  → litellm.<domain> (litellm_hostname), LiteLLM's own route. The
#              inference host has no route bound in this mode and answers 404,
#              so it must not be printed as the endpoint.
# Precedence: MM_INFERENCE_HOSTNAME env
#   litellm  → litellm_hostname (config.inference.yaml → global_config.yaml)
#              → litellm.<gateway_domain|base_domain_name>
#   keycloak → inference_hostname → <inference_prefix>.<gateway_domain|base_domain_name>
resolve_inference_hostname() {
    [[ -n "${MM_INFERENCE_HOSTNAME:-}" ]] && { echo "$MM_INFERENCE_HOSTNAME"; return; }

    local gc cfg h domain prefix=""
    gc=$(discover_global_config)

    if [[ "$(auth_provider)" == "litellm" ]]; then
        for cfg in "$(discover_inference_config 2>/dev/null)" "$gc"; do
            [[ -n "$cfg" && -f "$cfg" ]] || continue
            h=$(yq e '.litellm_hostname // ""' "$cfg" 2>/dev/null)
            [[ -n "$h" ]] && { echo "$h"; return; }
        done
        prefix="litellm"
    fi

    if [[ -n "$gc" && -f "$gc" ]]; then
        # inference_hostname/_prefix name the Keycloak-mode route only.
        if [[ -z "$prefix" ]]; then
            h=$(yq e '.inference_hostname // ""' "$gc" 2>/dev/null)
            [[ -n "$h" ]] && { echo "$h"; return; }
            prefix=$(yq e '.inference_prefix // "inference"' "$gc" 2>/dev/null)
        fi
        domain=$(yq e '.gateway_domain // .base_domain_name // ""' "$gc" 2>/dev/null)
        [[ -n "$domain" ]] && { echo "${prefix}.${domain}"; return; }
    fi

    warn "Could not resolve inference hostname — set MM_INFERENCE_HOSTNAME or MM_GLOBAL_CONFIG"
    echo ""
}

# Each auth mode serves every model on one unified URL — the model is selected
# via the request body, and the caller supplies either a Keycloak JWT or a
# LiteLLM key depending on the mode (the host differs per mode, see
# resolve_inference_hostname). Only fall back to a direct per-model URL when
# the gateway is explicitly disabled.
build_endpoint_url() {
    local host; host=$(resolve_inference_hostname)

    local api_path
    case "$MODEL_CATEGORY" in
        embed)  api_path="v1/embeddings" ;;
        rerank) api_path="v1/score" ;;
        *)      api_path="v1/chat/completions" ;;
    esac

    if aigateway_enabled; then
        echo "https://$host/$api_path"
    elif [[ "$MODEL_KIND" == "LLMInferenceService" ]]; then
        echo "https://$host/$MODEL_NAMESPACE/$MODEL_NAME/$api_path"
    else
        echo "https://$host/v2/models/$MODEL_NAME/infer"
    fi
}

build_sample_body() {
    case "$MODEL_CATEGORY" in
        embed)  jq -cn --arg m "$MODEL_NAME" '{model: $m, input: ["Hello world"]}' ;;
        rerank) jq -cn --arg m "$MODEL_NAME" '{model: $m, text_1: "query", text_2: ["doc1", "doc2"]}' ;;
        *)      jq -cn --arg m "$MODEL_NAME" '{model: $m, messages: [{role:"user", content:"Hello"}], max_tokens: 16}' ;;
    esac
}

print_endpoints() {
    local host gw_ip endpoint auth unified token_hint body sep
    host=$(resolve_inference_hostname)
    gw_ip=$(gateway_ip)
    endpoint=$(build_endpoint_url)
    auth=$(auth_provider)
    unified=false
    aigateway_enabled && unified=true

    # Auth mode drives the credential type — both hit the same unified URL.
    # token_hint is the shell variable the credential command below populates.
    if [[ "$auth" == "litellm" ]]; then
        token_hint="\$LITELLM_VIRTUAL_KEY"
    else
        token_hint="\$TOKEN"
    fi

    sep=$(printf '─%.0s' {1..56})
    echo -e "\n  ${CYAN}${sep}${RESET}"
    echo -e "  ${BOLD}Model:${RESET}    $MODEL_NAME  |  ${BOLD}Kind:${RESET} $MODEL_KIND  |  ${BOLD}Category:${RESET} $MODEL_CATEGORY"
    echo -e "  ${BOLD}Auth:${RESET}     $auth"
    [[ -n "$gw_ip" ]] && echo -e "  ${BOLD}Gateway:${RESET}  $gw_ip  (resolve $host → $gw_ip)"
    echo -e "  ${BOLD}Endpoint:${RESET} $endpoint"
    [[ "$unified" == true ]] && echo -e "  ${BOLD}Note:${RESET}     Pass \"model\": \"$MODEL_NAME\" in the request body"
    echo -e "  ${CYAN}${sep}${RESET}"

    # Step 1 — how to obtain the credential for this auth mode.
    if [[ "$auth" == "litellm" ]]; then
        echo -e "\n  ${BOLD}1. Get your LiteLLM API key:${RESET}"
        echo -e "  ${DIM}export LITELLM_VIRTUAL_KEY=\$(kubectl get secret $LITELLM_SECRET -n $LITELLM_NAMESPACE \\"
        echo -e "    -o jsonpath='{.data.master_key}' | base64 -d)${RESET}"
    else
        echo -e "\n  ${BOLD}1. Get a Keycloak token:${RESET}"
        echo -e "  ${DIM}source $SCRIPT_DIR/scripts/get-keycloak-token.sh${RESET}"
        echo -e "  ${DIM}# exports TOKEN, GATEWAY_IP, GATEWAY_DOMAIN${RESET}"
    fi

    # Step 2 — call the model with that credential.
    body=$(build_sample_body)
    echo -e "\n  ${BOLD}2. Call the model:${RESET}"
    echo -e "  ${DIM}curl -sk --noproxy \"*\" \\"
    echo -e "    -H \"Authorization: Bearer $token_hint\" -H \"Content-Type: application/json\" \\"
    [[ -n "$gw_ip" ]] && echo -e "    --resolve \"$host:443:$gw_ip\" \\"
    echo -e "    -d '$body' \\"
    echo -e "    $endpoint${RESET}\n"
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_deploy() {
    resolve_target "${1:-}"

    info "Deploying $MODEL_NAME ($MODEL_KIND)"
    info "  Runtime: $MODEL_RUNTIME${RUNTIME_VERSION:+ @ $RUNTIME_VERSION} | Category: $MODEL_CATEGORY | Routing: ${MODEL_ROUTING:-default}"
    info "  CPU: $MODEL_CPU | Memory: $MODEL_MEMORY | Replicas: $MODEL_REPLICAS"
    [[ -n "$MODEL_NODE" ]] && info "  Node: $MODEL_NODE"
    cpu_policy_resolve
    info "  CPU policy: $CPU_POLICY"

    # Normalise CPU/memory for the policy (kubelet-static rounds cpu to an
    # integer, and to a whole physical core under full-pcpus-only) and reject
    # values the policy cannot honour. Must run here, before render_manifest: it
    # mutates MODEL_CPU (which the renderer reads) and may abort — neither of
    # which works from inside the `$(render_manifest)` command substitution.
    # Also runs for --dry-run so the previewed manifest is the one that would be
    # applied. The placement pre-flight, by contrast, runs after the spec diff
    # below, so an unchanged re-deploy is not gated on its own reserved cores.
    cpu_policy_validate_resources

    local manifest
    manifest=$(render_manifest)
    if [[ "$DRY_RUN" == true ]]; then echo "$manifest"; return 0; fi

    # For an already-deployed model, a server-side diff against the rendered manifest decides:
    #   - unchanged  -> skip pre-flight + apply (the running workload already
    #                   holds its cores; re-running pre-flight would count them
    #                   against itself and falsely abort).
    #   - changed    -> re-apply (pre-flight still runs so a larger spec is
    #                   validated; note it double-counts the model's own current
    #                   reservation, so an in-place cpu/replica bump may need
    #                   MM_PREFLIGHT=warn / MM_NRI_PREFLIGHT=warn).
    #   - diff errored -> fall back to a readiness check: if the workload is
    #                   already Ready, skip (never crash a re-run on its own
    #                   cores); otherwise proceed to apply.
    # MM_FORCE_REDEPLOY=1 forces a full re-apply regardless.
    local action="apply"
    if [[ ! "${MM_FORCE_REDEPLOY:-}" =~ ^(true|1|yes)$ ]] \
       && kubectl get "$MODEL_KIND" "$MODEL_NAME" -n "$MODEL_NAMESPACE" &>/dev/null; then
        local diff_rc=0
        kubectl diff --server-side --field-manager=model-manager --force-conflicts \
            -f - <<< "$manifest" &>/dev/null || diff_rc=$?
        case "$diff_rc" in
            0) action="skip"; ok "$MODEL_NAME already deployed, spec unchanged — skipping apply" ;;
            1) info "$MODEL_NAME spec changed — re-applying" ;;
            *)
                if [[ "$(workload_ready "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME")" == "True" ]]; then
                    action="skip"
                    warn "$MODEL_NAME spec diff failed (rc=$diff_rc) but workload is Ready — skipping apply"
                else
                    warn "$MODEL_NAME spec diff failed (rc=$diff_rc) — applying"
                fi
                ;;
        esac
    fi

    # Inline Jinja rides in a ConfigMap. Applied unconditionally, NOT inside the
    # apply branch below: the CR references only the name-derived mount path, so
    # editing the template body leaves the rendered spec byte-identical and the
    # diff above reports action=skip — the ConfigMap would then never be
    # refreshed and the model would keep serving the old template. kubectl apply
    # is idempotent, so re-applying an unchanged ConfigMap is a no-op. Applied
    # BEFORE the CR so the volume it backs exists by the time the serving pod is
    # scheduled: a missing template file is fatal to vLLM ("appears path-like,
    # but doesn't exist!").
    if chat_template_needs_volume; then
        # On a first deploy the namespace is created by ensure_storage below,
        # which only runs on the apply path — the ConfigMap needs it to exist now.
        ensure_namespace "$MODEL_NAMESPACE"
        info "Storing chat template in ConfigMap: $(chat_template_cm_name)"
        apply_chat_template_cm "$(chat_template_cm_name)" "$MODEL_NAMESPACE" "$MODEL_CHAT_TEMPLATE"
    fi

    if [[ "$action" != "skip" ]]; then
        # Enforcing pre-flight for the active CPU policy: block a deploy that
        # cannot be placed (NRI: no physical-core room; kubelet-static: no single
        # node with enough allocatable CPU) before applying.
        cpu_policy_preflight_gate

        ensure_storage "$MODEL_NAMESPACE"

        # Prepare weights on the PVC before serving. Both engines use the prep job:
        # vLLM downloads raw weights; OpenVINO pulls + converts to IR and writes its
        # config_all.json (see download_weights). The serving pod then reads from the
        # PVC and fetches nothing.
        download_weights

        # Install the ClusterServingRuntime the first time we deploy this runtime.
        # The manifest is a mostly-static k8s object, so it stays a file. Its path
        # comes from the runtime's `serving_runtime_manifest:` pointer when set
        # (resolved relative to MM_RUNTIMES), else a conventional per-dir file
        # (serving-runtime.yaml, or the older runtime.yaml name for compatibility).
        # It is rendered (not applied raw) so the serving image tracks the runtime's
        # configured `image:` via the {{RUNTIME_IMAGE}} placeholder; KServe's own
        # {{.Name}} tokens are left intact by the simple key-based substitution.
        local rt_yaml=""
        if [[ -n "${RUNTIME_SERVING_MANIFEST:-}" ]]; then
            rt_yaml="$MM_RUNTIMES/$RUNTIME_SERVING_MANIFEST"
        elif [[ -f "$MM_RUNTIMES/$MODEL_RUNTIME/serving-runtime.yaml" ]]; then
            rt_yaml="$MM_RUNTIMES/$MODEL_RUNTIME/serving-runtime.yaml"
        else
            rt_yaml="$MM_RUNTIMES/$MODEL_RUNTIME/runtime.yaml"
        fi
        if [[ -f "$rt_yaml" ]] && ! runtime_installed "${RUNTIME_NAME:-$MODEL_RUNTIME-runtime}"; then
            info "Installing ClusterServingRuntime: ${RUNTIME_NAME:-$MODEL_RUNTIME-runtime}"
            kube_apply "$(render_template "$rt_yaml" "RUNTIME_IMAGE=$RUNTIME_IMAGE")"
        fi

        kube_ssa "$manifest"
        ok "Manifest applied: $MODEL_KIND/$MODEL_NAME in $MODEL_NAMESPACE"
    fi

    aigateway_register "$MODEL_NAME" "$MODEL_NAMESPACE" "$MODEL_KIND" "$MODEL_ROUTING" "$MODEL_CATEGORY"

    if [[ "$WAIT" == true ]]; then
        info "Waiting for $MODEL_NAME to become Ready (timeout: ${WAIT_TIMEOUT}s)..."
        local start=$SECONDS end=$((SECONDS + WAIT_TIMEOUT))
        local last_beat=0 last_msg=""
        while (( SECONDS < end )); do
            if [[ "$(workload_ready "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME")" == "True" ]]; then
                on_model_ready; print_endpoints; return 0
            fi
            # Heartbeat every ~15s so a slow model load (weights + warmup) doesn't
            # look stuck. Reports the serving pod's phase and elapsed time; only
            # reprints when the status text changes or every 4th beat.
            if (( SECONDS - last_beat >= 15 )); then
                local elapsed=$((SECONDS - start))
                local msg; msg=$(pod_progress "$MODEL_NAMESPACE" "$MODEL_NAME")
                if [[ "$msg" != "$last_msg" ]] || (( (SECONDS - start) % 60 < 15 )); then
                    info "  ${DIM}[$(fmt_duration "$elapsed")] $MODEL_NAME: ${msg}${RESET}"
                    last_msg="$msg"
                fi
                last_beat=$SECONDS
            fi
            sleep 5
        done
        warn "$MODEL_NAME did not become Ready within ${WAIT_TIMEOUT}s"
        warn "  Check progress: kubectl logs -n $MODEL_NAMESPACE -l app.kubernetes.io/name=$MODEL_NAME -f"
    else
        sleep 3
        if [[ "$(workload_ready "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME")" == "True" ]]; then
            on_model_ready
        else
            # Detached reconciler: keep polling until the workload is Ready, then
            # run on_model_ready (InferencePool patch + LiteLLM registration).
            # Without this, a no-wait deploy of a slow-loading model would never
            # register — the model would be served but unreachable through the
            # gateway/LiteLLM. Runs in the background so the CLI returns
            # immediately.
            #
            # Output goes to a log file, not /dev/null: this is the only record
            # that registration happened at all, and the failure mode it guards
            # against (model Running but missing from /v1/models) is otherwise
            # undiagnosable. Note the reconciler is still best-effort — it dies
            # with the session, so a terminal closed mid-load leaves the model
            # unregistered. The log says so; `deploy` again to reconcile.
            local recon_log="${MM_RECONCILE_LOG_DIR:-${TMPDIR:-/tmp}}/model-manager-reconcile-${MODEL_NAME}.log"
            (
                _end=$((SECONDS + WAIT_TIMEOUT))
                while (( SECONDS < _end )); do
                    if [[ "$(workload_ready "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME")" == "True" ]]; then
                        on_model_ready
                        exit 0
                    fi
                    sleep 10
                done
                warn "$MODEL_NAME not Ready within ${WAIT_TIMEOUT}s — gave up before reconciling routing."
                warn "  Reconcile with: ./model-manager deploy $MODEL_NAME"
            ) >"$recon_log" 2>&1 &
            disown 2>/dev/null || true

            info "$MODEL_NAME is starting in the background."
            # Yellow: this is the one line that sets the operator's expectations
            # — without it a not-yet-ready model reads as a failed deploy.
            info "  ${YELLOW}Model load + warmup can take a few minutes — try inference after a short while.${RESET}"
            # Name only what actually happens in this auth mode: LiteLLM
            # registration is gated on auth_provider=litellm (see
            # litellm_register), so under keycloak only the gateway route is
            # reconciled and mentioning LiteLLM sends the operator hunting for
            # a registration that will never appear.
            if litellm_enabled; then
                info "  Registration with LiteLLM/gateway completes automatically once it is Ready."
            else
                info "  AI Gateway routing is reconciled automatically once it is Ready."
            fi
            info "  Check status: kubectl get $MODEL_KIND $MODEL_NAME -n $MODEL_NAMESPACE"
            info "  Follow logs:  kubectl logs -n $MODEL_NAMESPACE -l app.kubernetes.io/name=$MODEL_NAME -f"
            info "  Reconcile log: $recon_log"
            info "  (or re-run with --wait to block until it is Ready)"
        fi
    fi
    print_endpoints
}

cmd_undeploy() {
    local target="${1:-}"
    [[ -z "$target" ]] && abort "No model specified. Use: model-manager undeploy <name>|all"
    if [[ "$target" == "all" ]]; then
        load_config "$MM_CONFIG"
        local name
        for name in $(list_model_names); do cmd_undeploy "$name"; done
        return 0
    fi

    # A catalog model resolves through the normal path (known kind/namespace/routing).
    # Anything else — e.g. a `--as <alias>` variant, or a model removed from the
    # catalog but still running — is discovered live from the cluster so it can
    # still be torn down by its deployed name.
    load_config "$MM_CONFIG"
    if list_model_names | grep -qxF "$target"; then
        resolve_target "$target"
    else
        _resolve_deployed "$target" || abort "No catalog entry or deployed resource named '$target' found."
    fi

    info "Undeploying $MODEL_NAME"
    crd_delete "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME"
    # Generated chat-template ConfigMap, if any. Deleted unconditionally (rather
    # than only when the catalog says chat_template:) so it is still reclaimed for
    # a model whose entry has since been edited or removed; --ignore-not-found
    # makes the no-template case a no-op.
    kubectl delete configmap "$(chat_template_cm_name)" -n "$MODEL_NAMESPACE" \
        --ignore-not-found >/dev/null 2>&1 || true
    aigateway_deregister "$MODEL_NAME" "$MODEL_NAMESPACE" "$MODEL_KIND" "$MODEL_ROUTING"
    litellm_deregister "$MODEL_NAME"

    # Deleting the CR above is asynchronous: the serving pods enter Terminating
    # and keep their pinned CPUs / NRI balloon until the graceful shutdown
    # completes. With --wait, block until they are actually gone so callers (and
    # a follow-up cpu-collisions-check) see the CPUs reclaimed. Bounded by
    # --wait-timeout so a stuck termination can't hang the CLI indefinitely.
    if [[ "$WAIT" == true ]]; then
        # Undeploy uses a short default (pod shutdown is quick); an explicit
        # --wait-timeout always wins. The wait returns the instant the pods are
        # gone, so this value is only a ceiling, not a fixed delay.
        local timeout="$UNDEPLOY_WAIT_TIMEOUT"
        [[ "$WAIT_TIMEOUT_SET" == true ]] && timeout="$WAIT_TIMEOUT"
        info "Waiting for $MODEL_NAME pods to terminate (timeout: ${timeout}s)..."
        if wait_pods_gone "$MODEL_NAMESPACE" "$MODEL_NAME" "$timeout"; then
            ok "$MODEL_NAME undeployed (all pods terminated, CPUs released)"
        else
            warn "$MODEL_NAME undeployed, but pods are still terminating after ${timeout}s — CPUs/balloons may not be reclaimed yet"
            warn "  Check: kubectl get pods -n $MODEL_NAMESPACE -l app.kubernetes.io/name=$MODEL_NAME"
        fi
    else
        ok "$MODEL_NAME undeployed"
    fi
}

# Discover a live deployment by name when it has no catalog entry (e.g. an
# `--as` alias). Locates the resource across the known serving kinds, captures
# its namespace + routing from the live object, and sets the MODEL_* vars that
# cmd_undeploy needs. Returns non-zero if nothing is found.
_resolve_deployed() {
    local name="$1" ns="${DEFAULT_NAMESPACE:-llm-inference}"
    local kind found_ns
    for kind in LLMInferenceService InferenceService; do
        # Prefer the default namespace; fall back to a cluster-wide lookup so an
        # alias deployed elsewhere is still found.
        found_ns=$(kubectl get "$kind" "$name" -n "$ns" -o jsonpath='{.metadata.namespace}' 2>/dev/null) || true
        [[ -z "$found_ns" ]] && found_ns=$(kubectl get "$kind" -A --field-selector "metadata.name=$name" \
            -o jsonpath='{.items[0].metadata.namespace}' 2>/dev/null) || true
        if [[ -n "$found_ns" ]]; then
            MODEL_NAME="$name"
            MODEL_KIND="$kind"
            MODEL_NAMESPACE="$found_ns"
            # Detect routing mode so deregister targets the right resources.
            if kubectl get httproute "direct-$name" -n "$found_ns" &>/dev/null; then
                MODEL_ROUTING="direct"
            elif kubectl get aigatewayroute "aigw-$name" -n "$found_ns" &>/dev/null 2>&1 \
                 && kubectl get aiservicebackend "$name" -n "$found_ns" &>/dev/null 2>&1; then
                MODEL_ROUTING="aigateway"
            else
                MODEL_ROUTING="epp"
            fi
            info "Discovered live $kind/$name in $found_ns (no catalog entry)"
            return 0
        fi
    done
    return 1
}

# Retained as a reusable helper (endpoints are now printed automatically after
# deploy). Not wired into the CLI dispatch — call directly if needed.
cmd_get_endpoints() {
    local target="${1:-all}"
    load_config "$MM_CONFIG"

    if [[ "$target" != "all" ]]; then
        resolve_target "$target"
        local state; state=$(crd_ready "$MODEL_KIND" "$MODEL_NAMESPACE" "$MODEL_NAME")
        case "$state" in
            True)     ok "$MODEL_NAME is Ready" ;;
            NotFound) warn "$MODEL_NAME is not deployed — the URL below will 404 until you run: ./model-manager deploy $MODEL_NAME" ;;
            *)        warn "$MODEL_NAME is not yet Ready (state: $state) — the URL will start responding once it is" ;;
        esac
        print_endpoints
        return 0
    fi

    local ns="${DEFAULT_NAMESPACE:-llm-inference}"
    local -A deployed=()
    local raw n
    raw=$(kubectl get llminferenceservices,inferenceservices -n "$ns" \
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null) || raw=""
    while IFS= read -r n; do [[ -n "$n" ]] && deployed["$n"]=1; done <<< "$raw"

    local shown=0
    for n in $(list_model_names); do
        resolve_target_quick "$n"
        [[ -z "$MODEL_CATEGORY" ]] && MODEL_CATEGORY="llm"
        [[ -z "${deployed[$MODEL_NAME]:-}" ]] && continue
        print_endpoints; echo
        shown=$((shown + 1))
    done
    (( shown == 0 )) && warn "No models from $MM_CONFIG are currently deployed. Run: ./model-manager deploy <name>"
}

# ── CPU collisions check ─────────────────────────────────────────────────────
cmd_cpu_collisions_check() {
    local ns
    ns=$(yq_read ".defaults.namespace" "$MM_CONFIG" 2>/dev/null || echo "llm-inference")
    local report_script="$SCRIPT_DIR/scripts/nri-cpu-report.py"
    if [[ ! -f "$report_script" ]]; then
        abort "nri-cpu-report.py not found at $report_script"
    fi
    if ! command -v python3 &>/dev/null; then
        abort "python3 is required for cpu-collisions-check"
    fi
    info "Running CPU pinning & collision report (namespace: $ns)"
    python3 "$report_script" --namespace "$ns"
}

# ── Main dispatch ────────────────────────────────────────────────────────────
main() {
    parse_args "$@"

    local command="${POSITIONAL[0]:-}"
    local target="${POSITIONAL[1]:-}"

    [[ -z "$command" ]] && { usage; exit 1; }

    case "$command" in
        version|-v|--version) echo "model-manager $MM_VERSION"; exit 0 ;;
        help|--help|-h)       usage; exit 0 ;;
    esac

    check_prerequisites

    case "$command" in
        deploy)               cmd_deploy               "$target" ;;
        undeploy)             cmd_undeploy             "$target" ;;
        cpu-collisions-check) cmd_cpu_collisions_check          ;;
        *) abort "Unknown command: $command (run ./model-manager --help)" ;;
    esac
}

main "$@"
