#!/usr/bin/env python3
"""Fake kubectl: logs mutating calls (+ stdin) to FAKE_K8S_LOG, answers from FAKE_K8S rules."""
import json
import os
import re
import sys

argv = sys.argv[1:]
line = " ".join(argv)
verb = argv[0] if argv else ""
stdin = sys.stdin.read() if verb in ("apply", "create") and "-" in argv else ""
if verb in ("apply", "create", "delete", "patch", "run") and os.environ.get("FAKE_K8S_LOG"):
    with open(os.environ["FAKE_K8S_LOG"], "a", encoding="utf-8") as log:
        log.write(f"$ kubectl {line}\n{stdin}")
# Rules: [[regex, rc, stdout], ...]; first match wins. Unmatched reads fail (not found).
for pattern, rc, out in json.loads(os.environ.get("FAKE_K8S") or "[]"):
    if re.search(pattern, line):
        sys.stdout.write(out)
        sys.exit(rc)
sys.exit(1 if verb == "get" else 0)
