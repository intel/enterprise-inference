#!/usr/bin/env bash
# Fake curl: the HuggingFace model API answers FAKE_HF_JSON (or fails); other URLs succeed silently.
for a in "$@"; do
    if [[ "$a" == https://huggingface.co/api/models/* ]]; then
        [[ -n "${FAKE_HF_JSON:-}" ]] || exit 22
        printf '%s' "$FAKE_HF_JSON"
        exit 0
    fi
done
exit 0
